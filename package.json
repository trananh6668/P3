{
  "name": "xiangqi-wasm",
  "private": true,
  "version": "1.0.0",
  "description": "Ứng dụng Cờ Tướng (Xiangqi) offline với engine Fairy-Stockfish WebAssembly chạy trong Web Worker",
  "type": "module",
  "license": "GPL-3.0",
  "scripts": {
    "copy-engine": "node scripts/copy-engine.mjs",
    "postinstall": "node scripts/copy-engine.mjs",
    "predev": "node scripts/copy-engine.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-engine.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "fairy-stockfish-nnue.wasm": "1.1.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  }
}
